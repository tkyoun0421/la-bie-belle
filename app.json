{
  "expo": {
    "name": "라비에벨",
    "slug": "la-bie-belle",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "labiebelle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.labiebelle.app"
    },
    "android": {
      "package": "com.labiebelle.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
