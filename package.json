{
  "name": "la-bie-belle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check:app-build": "node scripts/check-app-build.mjs",
    "gate:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/index.ts",
    "gate:radio": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/radio.ts",
    "gate:handoff": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/handoff.ts",
    "gate:tdd": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/tdd.ts",
    "gate:scope": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/scope.ts",
    "gate:all": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/all.ts",
    "dashboard": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/dashboard/main.ts",
    "harness:self-test": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/self-test/run.ts",
    "harness:typecheck": "tsc --noEmit --project harness/tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  }
}
