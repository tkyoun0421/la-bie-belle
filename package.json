{
  "name": "la-bie-belle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check:app-build": "node scripts/check-app-build.mjs",
    "lint": "eslint src",
    "lint:ci": "eslint src -c eslint.config.ci.mjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "verify": "pnpm format:check && pnpm lint:ci && pnpm typecheck && pnpm test && pnpm harness:typecheck && pnpm harness:self-test && pnpm build && pnpm test:e2e && pnpm gate:all",
    "prepare": "git config core.hooksPath .githooks",
    "gate:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/index.ts",
    "gate:radio": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/radio.ts",
    "gate:handoff": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/handoff.ts",
    "gate:tdd": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/tdd.ts",
    "gate:scope": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/scope.ts",
    "gate:all": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/gates/all.ts",
    "dashboard": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/dashboard/main.ts",
    "harness:self-test": "node --experimental-strip-types --disable-warning=ExperimentalWarning harness/self-test/run.ts",
    "harness:typecheck": "tsc --noEmit --project harness/tsconfig.json"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4",
    "eslint": "10",
    "eslint-plugin-import-x": "4",
    "eslint-plugin-react-hooks": "7",
    "jsdom": "^30.0.1",
    "lint-staged": "16",
    "postcss": "^8.5.25",
    "prettier": "3",
    "prettier-plugin-tailwindcss": "0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8",
    "vitest": "4"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  }
}
