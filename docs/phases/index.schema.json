{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-bie-belle.local/schemas/phase-index-item.json",
  "title": "La Bie Belle phase index item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "phase",
    "title",
    "summary",
    "status",
    "priority",
    "depends_on",
    "doc",
    "spec_refs",
    "verification",
    "tags",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "kind": {
      "enum": ["phase", "task"]
    },
    "id": {
      "type": "string",
      "pattern": "^P[0-9]+(?:-T[0-9]{2})?$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["proposed", "design_pending", "planned", "in_progress", "blocked", "verification_pending", "done", "skipped"]
    },
    "priority": {
      "enum": ["must", "should", "could"]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P[0-9]+(?:-T[0-9]{2})?$"
      }
    },
    "doc": {
      "type": "string",
      "pattern": "^docs/phases/.+\\.md$"
    },
    "spec_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:PRD:(?:INV-[A-Z]+-[0-9]{2}|AC-[0-9]{2})|DOMAIN:[A-Z][A-Z0-9-]*|ADR:[0-9]{4}|DOCS:(?:SDD|DDD))$"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_mode": {
      "enum": ["docs_only", "verification", "tdd"]
    },
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "approved_by": {
      "const": "user"
    },
    "approved_at": {
      "type": "string",
      "format": "date"
    },
    "approval_contract": {
      "enum": ["legacy-v2", "dual-approval-v3"]
    },
    "product_approval": {
      "$ref": "#/$defs/approval"
    },
    "development_approval": {
      "$ref": "#/$defs/developmentApproval"
    },
    "skip_approval": {
      "$ref": "#/$defs/skipApproval"
    },
    "radio_ref": {
      "type": "string",
      "pattern": "^docs/development/P[0-9]+-T[0-9]{2}-radio\\.md$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at"],
      "properties": {
        "by": {
          "const": "user"
        },
        "at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "developmentApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "radio_revision", "radio_sha256"],
      "properties": {
        "by": {
          "const": "user"
        },
        "at": {
          "type": "string",
          "format": "date"
        },
        "radio_revision": {
          "type": "integer",
          "minimum": 1
        },
        "radio_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "skipApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "reason"],
      "properties": {
        "by": {
          "const": "user"
        },
        "at": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "phase"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^P[0-9]+$"
          }
        },
        "not": {
          "required": ["approval_contract"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "required": ["approval_contract"],
        "properties": {
          "id": {
            "pattern": "^P[0-9]+-T[0-9]{2}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "approval_contract": {
            "const": "legacy-v2"
          }
        },
        "required": ["kind", "approval_contract"]
      },
      "then": {
        "properties": {
          "status": {
            "enum": ["done", "skipped"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "approval_contract": {
            "const": "dual-approval-v3"
          },
          "status": {
            "const": "design_pending"
          }
        },
        "required": ["kind", "approval_contract", "status"]
      },
      "then": {
        "required": ["product_approval"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "approval_contract": {
            "const": "dual-approval-v3"
          },
          "status": {
            "enum": ["planned", "in_progress", "blocked", "verification_pending", "done"]
          }
        },
        "required": ["kind", "approval_contract", "status"]
      },
      "then": {
        "required": ["test_mode", "check_ids"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "approval_contract": {
            "const": "dual-approval-v3"
          },
          "status": {
            "enum": ["planned", "in_progress", "blocked", "verification_pending", "done"]
          }
        },
        "required": ["kind", "approval_contract", "status"]
      },
      "then": {
        "required": ["product_approval", "development_approval", "radio_ref"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "approval_contract": {
            "const": "dual-approval-v3"
          },
          "status": {
            "const": "skipped"
          }
        },
        "required": ["kind", "approval_contract", "status"]
      },
      "then": {
        "required": ["skip_approval"]
      }
    }
  ]
}
