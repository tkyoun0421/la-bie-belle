{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-bie-belle.local/schemas/phase-index-item.json",
  "title": "La Bie Belle phase index item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "phase",
    "title",
    "summary",
    "status",
    "priority",
    "depends_on",
    "doc",
    "acceptance",
    "verification",
    "tags",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": ["phase", "task"]
    },
    "id": {
      "type": "string",
      "pattern": "^P[0-9]+(?:-T[0-9]{2})?$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["planned", "in_progress", "blocked", "done", "skipped"]
    },
    "priority": {
      "enum": ["must", "should", "could"]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P[0-9]+(?:-T[0-9]{2})?$"
      }
    },
    "doc": {
      "type": "string",
      "pattern": "^docs/phases/.+\\.md$"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "phase"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^P[0-9]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^P[0-9]+-T[0-9]{2}$"
          }
        }
      }
    }
  ]
}
