{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-bie-belle.local/schemas/phase-index-item.json",
  "title": "La Bie Belle phase index item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "phase",
    "title",
    "summary",
    "status",
    "priority",
    "depends_on",
    "doc",
    "spec_refs",
    "verification",
    "tags",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "enum": ["phase", "task"]
    },
    "id": {
      "type": "string",
      "pattern": "^P[0-9]+(?:-T[0-9]{2})?$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["proposed", "planned", "in_progress", "blocked", "verification_pending", "done", "skipped"]
    },
    "priority": {
      "enum": ["must", "should", "could"]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P[0-9]+(?:-T[0-9]{2})?$"
      }
    },
    "doc": {
      "type": "string",
      "pattern": "^docs/phases/.+\\.md$"
    },
    "spec_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:PRD:(?:INV-[A-Z]+-[0-9]{2}|AC-[0-9]{2})|DOMAIN:[A-Z][A-Z0-9-]*|ADR:[0-9]{4}|DOCS:(?:SDD|DDD))$"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_mode": {
      "enum": ["docs_only", "verification", "tdd"]
    },
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "approved_by": {
      "const": "user"
    },
    "approved_at": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "phase"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^P[0-9]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^P[0-9]+-T[0-9]{2}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "status": {
            "enum": ["planned", "in_progress", "blocked", "verification_pending"]
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "required": ["test_mode", "check_ids"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "status": {
            "enum": ["planned", "in_progress", "blocked", "verification_pending"]
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "required": ["approved_by", "approved_at"]
      }
    }
  ]
}
