#!/bin/sh
set -eu
repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

node --experimental-strip-types --disable-warning=ExperimentalWarning \
  "$repo_root/harness/gates/pre-commit.ts"

if [ ! -f "$repo_root/package.json" ] || [ ! -d "$repo_root/node_modules" ]; then
  echo "pre-commit: 프로젝트 의존성이 없어 format·lint·type·test 검사를 건너뜁니다. pnpm install 후 다시 커밋하거나 CI의 pnpm verify로 확인하세요." >&2
  exit 0
fi

pnpm exec lint-staged
pnpm exec tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo

node --experimental-strip-types --disable-warning=ExperimentalWarning \
  "$repo_root/harness/gates/precommit-test.ts"
