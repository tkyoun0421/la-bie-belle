{
  "layers": ["app", "views", "widgets", "features", "entities", "shared"],
  "appLayer": {
    "unitTest": "required",
    "exemptFiles": [
      "page.tsx",
      "layout.tsx",
      "loading.tsx",
      "error.tsx",
      "global-error.tsx",
      "not-found.tsx",
      "template.tsx",
      "default.tsx",
      "page.dev.tsx"
    ]
  },
  "segments": {
    "ui": {
      "unitTest": "exempt",
      "verifiedBy": ["component", "e2e"],
      "runtimeExports": true,
      "forbidImports": ["server-only", "**/api/**"],
      "noLogic": true
    },
    "hooks": {
      "unitTest": "required",
      "verifiedBy": ["unit"],
      "runtimeExports": true,
      "forbidImports": ["server-only"]
    },
    "model": {
      "unitTest": "required",
      "verifiedBy": ["unit"],
      "runtimeExports": true,
      "forbidImports": ["react", "react-dom", "server-only"]
    },
    "api": {
      "unitTest": "required",
      "verifiedBy": ["unit"],
      "runtimeExports": true,
      "requireServerOnly": true
    },
    "lib": {
      "unitTest": "required",
      "verifiedBy": ["unit"],
      "runtimeExports": true
    },
    "config": {
      "unitTest": "exempt",
      "verifiedBy": [],
      "runtimeExports": "constants"
    },
    "types": {
      "unitTest": "exempt",
      "verifiedBy": [],
      "runtimeExports": false
    }
  },
  "exemptPaths": ["**/generated/**"],
  "testPlacement": { "directory": "__tests__", "suffix": ".test" },
  "naming": {
    "folder": "kebab-case",
    "file": "kebab-case",
    "componentFile": "PascalCase",
    "hookFile": "useCamelCase",
    "exceptions": ["src/app/**", "src/shared/ui/**", "**/__tests__/**"]
  }
}
